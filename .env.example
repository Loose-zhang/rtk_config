# RTKRCV 监控服务环境变量示例
# 复制为实际环境变量或写入 systemd/pm2 配置。未设置时使用 config.js 中的默认值。
# 注意：Linux 下默认路径为 /root/ppp_station_monitor/rtk_config/...（当前生产部署路径）

# HTTP 服务端口
PORT=3000
# TCP 数据接收端口（rtkrcv outstr 输出目标）
TCP_PORT=60000

# 路径配置（生产环境当前默认值如下）
TEMPLATE_PATH=/root/ppp_station_monitor/rtk_config/bbb.conf
GENERATED_DIR=/root/ppp_station_monitor/rtk_config/generated
RTKRCV_PATH=/root/ppp_station_monitor/rtk_config/generated/rtkrcv
RTKRCV_WORKDIR=/root/ppp_station_monitor/rtk_config/generated

# CORS
CORS_ORIGIN=*
# 日志级别: debug | info | warn | error
LOG_LEVEL=info

# 稳定性判定
STABILITY_REQUIRED_SECONDS=10
STABILITY_CRITERIA=both        # seconds | samples | both
STABILITY_REQUIRED_SAMPLES=40
NON_FIXED_TOLERANCE_SECONDS=5
MAX_SAMPLE_INTERVAL_SECONDS=2

# 性能
SSE_MIN_INTERVAL_MS=500
ENABLE_RAW_DATA_LOG=false
MAX_SAMPLES_PER_STATION=120
KEEP_SAMPLES_AFTER_STABLE=false
CHILD_PROCESS_PRIORITY=low

# 日志轮转与缓存清理
MAX_LOG_SIZE_MB=20
# SIGTERM 宽限时间（毫秒），超时未退出则 SIGKILL
KILL_GRACE_MS=10000
CACHE_SWEEP_INTERVAL_MS=600000
CACHE_MAX_IDLE_MS=3600000

# GPS 闰秒（IERS 调整时更新，2017 年起为 18）
GPS_LEAP_SECONDS=18

# MySQL（仅用于写入平均后的稳定结果；不配置则禁用数据库功能）
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=change_me
MYSQL_DATABASE=mydb
