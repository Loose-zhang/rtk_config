# systemd 服务示例 —— 复制到 /etc/systemd/system/rtk-config.service 后按需修改
[Unit]
Description=RTKRCV Config Generator & Station Monitor
After=network.target mysql.service
Wants=mysql.service

[Service]
Type=simple
WorkingDirectory=/root/ppp_station_monitor/rtk_config
ExecStart=/usr/bin/node server.js
Restart=always
RestartSec=5
# 环境变量（也可用 EnvironmentFile=/root/ppp_station_monitor/rtk_config/.env）
Environment=NODE_ENV=production
Environment=LOG_LEVEL=info
# Environment=MYSQL_PASSWORD=xxxx

# 资源限制（可选）
# MemoryMax=1G
# CPUQuota=200%

StandardOutput=append:/var/log/rtk-config.log
StandardError=append:/var/log/rtk-config.log

[Install]
WantedBy=multi-user.target
